# Backend Environment Configuration

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Azure OpenAI Configuration (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
